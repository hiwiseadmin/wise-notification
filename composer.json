{
    "name": "wiseadmin/wise-notification",
    "description": "WiseAdmin 多通道消息通知组件 — 支持邮件、短信、钉钉、站内信等通道，提供模板引擎、中间件与事件驱动能力",
    "homepage": "https://github.com/hiwiseadmin/wise-notification",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "thinkphp",
        "notification",
        "sms",
        "email",
        "dingtalk",
        "message"
    ],
    "authors": [
        {
            "name": "WiseAdmin Team",
            "email": "wiseadmin@126.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^6.0 || ^8.0",
        "topthink/think-queue": "^2.0 || ^3.0",
        "topthink/think-migration": "^2.0 || ^3.0",
        "topthink/think-orm": "^2.0 || ^3.0",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "suggest": {
        "phpmailer/phpmailer": "^6.9",
        "alibabacloud/dysmsapi": "^2.0",
        "tencentcloud/sms": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "wise\\notification\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "wise\\notification\\tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "think": {
            "services": [
                "wise\\notification\\Service"
            ],
            "config": {
                "wise-notification": "config/wise-notification.php"
            },
            "migrate-path": "database/migrations"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/docs",
            "/.github",
            "/phpunit.xml",
            "/.gitattributes",
            "/.gitignore",
            "/*.md",
            "!/README.md",
            "/qa/"
        ]
    }
}
